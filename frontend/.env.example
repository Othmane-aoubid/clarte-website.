# ── Site ──────────────────────────────────────────────────────────────────────
# The public URL of your deployed frontend (used in metadata, sitemap, OG tags)
NEXT_PUBLIC_SITE_URL=https://<your-domain>

# ── Backend API ───────────────────────────────────────────────────────────────
# URL of your deployed FastAPI backend, accessible from the browser
NEXT_PUBLIC_API_URL=https://<your-railway-app>.railway.app/api/v1

# ── Supabase ──────────────────────────────────────────────────────────────────
# Supabase dashboard → Project settings → API
NEXT_PUBLIC_SUPABASE_URL=https://<your-project>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<your-supabase-anon-key>

# ── Stripe (client-side — safe to expose) ─────────────────────────────────────
# Stripe dashboard → Developers → API keys → Publishable key
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_<your-stripe-publishable-key>

# ── Google Search Console ──────────────────────────────────────────────────────
# Google Search Console → Settings → Ownership verification → HTML tag → content value
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=<your-verification-code>
