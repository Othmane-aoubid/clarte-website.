# ── Application ───────────────────────────────────────────────────────────────
ENVIRONMENT=development
DEBUG=true

# ── Database (Supabase Postgres) ───────────────────────────────────────────────
# Supabase dashboard → Project settings → Database → Connection string (Session mode, port 5432)
DATABASE_URL=postgresql+asyncpg://<user>:<password>@<host>:5432/<dbname>

# ── Supabase Auth ─────────────────────────────────────────────────────────────
# Supabase dashboard → Project settings → API → JWT Secret
SUPABASE_JWT_SECRET=<your-supabase-jwt-secret>

# Service role key — keep secret, never expose to frontend
# Supabase dashboard → Project settings → API → service_role key
SUPABASE_SERVICE_KEY=<your-supabase-service-role-key>

# ── Stripe ────────────────────────────────────────────────────────────────────
# Stripe dashboard → Developers → API keys
STRIPE_SECRET_KEY=sk_test_<your-stripe-secret-key>

# Stripe dashboard → Developers → Webhooks → signing secret
STRIPE_WEBHOOK_SECRET=whsec_<your-stripe-webhook-secret>

# ── Email (Resend) ────────────────────────────────────────────────────────────
# resend.com → API Keys → Create
RESEND_API_KEY=re_<your-resend-api-key>

# ── Internal ──────────────────────────────────────────────────────────────────
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
INTERNAL_API_KEY=<generate-a-random-hex-secret>

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:3000", "https://<your-vercel-app>.vercel.app"]
